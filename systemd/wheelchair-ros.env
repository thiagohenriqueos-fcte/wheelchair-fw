# Argumentos passados ao launch unificado pelo serviço systemd.
# Edite e rode:  sudo systemctl restart wheelchair-ros
#
#   nav:=true|false        sobe rf2o + EKF + slam_toolbox (pesado)
#   armed:=true|false      true = a ponte pode mover o motor (só após validar!)
#   assist_gain:=0.0..1.0  0 = só freio/parada; >0 = desvio autônomo
#   max_duty:=0.20         teto de duty (comece baixo)
#
# Default seguro: navegação ligada, DESARMADO.
WHEELCHAIR_LAUNCH_ARGS=nav:=true armed:=false
